{
  "name": "@jkin8010/dsh-code-review",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "代码评审中心：基于 alibaba/open-code-review 的 DeepSeek Harness 插件，支持当前改动/提交/分支、项目架构、代码模块与信息流业务工作流评审，提供实时进度与动态、GitHub 风格提交热力图与评审统计。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "host/*.js",
    "README.md",
    "locale/*.json",
    "icon.svg"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jkin8010/dsh-code-review.git",
    "directory": "plugins/dsh-code-review"
  },
  "homepage": "https://github.com/jkin8010/dsh-code-review#readme",
  "bugs": {
    "url": "https://github.com/jkin8010/dsh-code-review/issues"
  },
  "license": "Apache-2.0",
  "author": "jkin8010",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "code-review",
    "open-code-review",
    "ai-code-review",
    "static-analysis",
    "architecture-review"
  ]
}
