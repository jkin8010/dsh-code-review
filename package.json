{
  "name": "@jkin8010/dsh-code-review",
  "version": "0.9.6",
  "type": "module",
  "description": "代码评审中心：基于 alibaba/open-code-review 的 DeepSeek Harness 插件，支持当前改动/提交/分支、项目架构、代码模块与信息流业务工作流评审，提供实时进度与动态、GitHub 风格提交热力图与评审统计。",
  "license": "Apache-2.0",
  "author": "jkin8010",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jkin8010/dsh-code-review.git"
  },
  "homepage": "https://github.com/jkin8010/dsh-code-review#readme",
  "bugs": {
    "url": "https://github.com/jkin8010/dsh-code-review/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "test": "node tests/code-review/engine-selftest.mjs && node tests/code-review/delegate-selftest.mjs && node tests/code-review/tool-selftest.mjs && node tests/code-review/analyze.test.mjs && node tests/code-review/ocr-spawn.test.mjs",
    "test:full": "npm test && node tests/code-review/host-selftest.mjs && node tests/code-review/git-ocr.test.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "code-review",
    "open-code-review",
    "ai-code-review",
    "static-analysis",
    "architecture-review"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "host/*.js",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}